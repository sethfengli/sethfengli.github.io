   ]
  },
  {
   "t": "p",
   "inline": [
    {
     "s": "妈妈开刀时我一直在外面帮她持观世音菩萨圣号"
    },
    {
     "s": "，"
    },
    {
     "s": "开刀很顺利"
    },
    {
     "s": "，"
    },
