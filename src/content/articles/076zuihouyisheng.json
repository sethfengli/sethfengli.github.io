{
 "slug": "076zuihouyisheng",
 "title": "今生，将是我在娑婆世界里的最后一生（朗诵）",
 "author": "",
 "school": "xiuxue",
 "illustration": "meditation",
 "excerpt": "我将永远告别这个娑婆世界，",
 "chars": 759,
 "blocks": [
  {
   "t": "h2",
   "text": "今生，将是我在娑婆世界里的最后一生"
  },
  {
   "t": "p",
   "inline": [
    {
     "s": "今生，"
    }
   ]
  },
  {
   "t": "p",
   "inline": [
    {
     "s": "将是我在娑婆世界里的，"
    }
   ]
  },
  {
   "t": "p",
   "inline": [
    {
     "s": "最后一生。"
    }
   ]
  },
  {
   "t": "p",
   "inline": [
    {
     "s": "如若，"
    }
   ]
  },
  {
   "t": "p",
   "inline": [
    {
     "s": "我是来还债的，"
    }
   ]
  },
  {
   "t": "p",
   "inline": [
    {
     "s": "那就尽量多还一些，"
    }
   ]
  },
  {
   "t": "p",
   "inline": [
    {
     "s": "宁可人负我，"
    }
   ]
  },
  {
   "t": "p",
   "inline": [
    {
     "s": "我绝不负人，"
    }
   ]
  },
  {
   "t": "p",
   "inline": [
    {
     "s": "让那多还的,"
    }
   ]
  },
  {
   "t": "p",
   "inline": [
    {
     "s": "成为能被再来的我，"
    }
   ]
  },
  {
   "t": "p",
   "inline": [
    {
     "s": "勾牵的因。"
    },
    {
     "s": "（"
    },
    {
     "s": "度化的缘。）"
    }
   ]
  },
  {
   "t": "p",
   "inline": [
    {
     "s": "我是来报恩的，"
    }
   ]
  },
  {
   "t": "p",
   "inline": [
    {
     "s": "那就尽量多报一些，"
    }
   ]
  },
  {
   "t": "p",
   "inline": [
    {
     "s": "今生为人实属不易，"
    }
   ]
  },
  {
   "t": "p",
   "inline": [
    {
     "s": "我要把人性发挥到极致。"
    }
   ]
  },
  {
   "t": "p",
   "inline": [
    {
     "s": "每当遭遇困境、"
    }
   ]
  },
  {
   "t": "p",
   "inline": [
    {
     "s": "面对挫折、"
    }
   ]
  },
  {
   "t": "p",
   "inline": [
    {
     "s": "感觉不被理解、"
    }
   ]
  },
  {
   "t": "p",
   "inline": [
    {
     "s": "内心不能够平静的时候，"
    }
   ]
  },
  {
   "t": "p",
   "inline": [
    {
     "s": "告诉自己："
    }
   ]
  },
  {
   "t": "p",
   "inline": [
    {
     "s": "今生已经是最后一生，"
    }
   ]
  },
  {
   "t": "p",
   "inline": [
    {
     "s": "我将永远告别这个娑婆世界，"
    }
   ]
  },
  {
   "t": "p",
   "inline": [
    {
     "s": "没有什么值得长久计较。"
    }
   ]
  },
  {
   "t": "p",
   "inline": [
    {
     "s": "虽一时之间，"
    }
   ]
  },
  {
   "t": "p",
   "inline": [
    {
     "s": "偶尔会有抵触与抱怨，"
    }
   ]
  },
  {
   "t": "p",
   "inline": [
    {
     "s": "但我会很快提醒自己，"
    }
   ]
  },
  {
   "t": "p",
   "inline": [
    {
     "s": "保持正念、觉知。"
    }
   ]
  },
  {
   "t": "p",
   "inline": [
    {
     "s": "此生，"
    }
   ]
  },
  {
   "t": "p",
   "inline": [
    {
     "s": "无论我拥有怎样的父母、"
    }
   ]
  },
  {
   "t": "p",
   "inline": [
    {
     "s": "儿女、爱人、兄弟、姊妹，"
    }
   ]
  },
  {
   "t": "p",
   "inline": [
    {
     "s": "遇见怎样的朋友、同道、同修；"
    }
   ]
  },
  {
   "t": "p",
   "inline": [
    {
     "s": "无论我每日里，"
    }
   ]
  },
  {
   "t": "p",
   "inline": [
    {
     "s": "与何种人混迹在一起"
    },
    {
     "s": "。"
    }
   ]
  },
  {
   "t": "p",
   "inline": [
    {
     "s": "我知道，"
    }
   ]
  },
  {
   "t": "p",
   "inline": [
    {
     "s": "我与他们之间，"
    }
   ]
  },
  {
   "t": "p",
   "inline": [
    {
     "s": "都将是最后一世相遇，"
    }
   ]
  },
  {
   "t": "p",
   "inline": [
    {
     "s": "最后一世的缘聚。"
    }
   ]
  },
  {
   "t": "p",
   "inline": [
    {
     "s": "在这最后一生当中，"
    }
   ]
  },
  {
   "t": "p",
   "inline": [
    {
     "s": "能与他们相逢，"
    }
   ]
  },
  {
   "t": "p",
   "inline": [
    {
     "s": "我应该格外珍惜。"
    }
   ]
  },
  {
   "t": "p",
   "inline": [
    {
     "s": "无论，"
    }
   ]
  },
  {
   "t": "p",
   "inline": [
    {
     "s": "现在我住在甚么样的房子里，"
    }
   ]
  },
  {
   "t": "p",
   "inline": [
    {
     "s": "从事的职业是否满意，"
    }
   ]
  },
  {
   "t": "p",
   "inline": [
    {
     "s": "经济是否丰盛，"
    }
   ]
  },
  {
   "t": "p",
   "inline": [
    {
     "s": "资粮是否备足，"
    },
    {
     "s": "（钱财"
    },
    {
     "s": "是否备足，）"
    }
   ]
  },
  {
   "t": "p",
   "inline": [
    {
     "s": "都不重要"
    },
    {
     "s": "。"
    }
   ]
  },
  {
   "t": "p",
   "inline": [
    {
     "s": "这些都是前世注定的，"
    }
   ]
  },
  {
   "t": "p",
   "inline": [
    {
     "s": "走完这一生，"
    }
   ]
  },
  {
   "t": "p",
   "inline": [
    {
     "s": "我将永远不再重复着，"
    }
   ]
  },
  {
   "t": "p",
   "inline": [
    {
     "s": "同样的生活。"
    }
   ]
  },
  {
   "t": "p",
   "inline": [
    {
     "s": "那么，"
    }
   ]
  },
  {
   "t": "p",
   "inline": [
    {
     "s": "再最后一次品尝着，"
    }
   ]
  },
  {
   "t": "p",
   "inline": [
    {
     "s": "做人的滋味吧。"
    }
   ]
  },
  {
   "t": "p",
   "inline": [
    {
     "s": "这味道也许不好，"
    }
   ]
  },
  {
   "t": "p",
   "inline": [
    {
     "s": "但它却是留给自己,"
    }
   ]
  },
  {
   "t": "p",
   "inline": [
    {
     "s": "在红尘世间，"
    }
   ]
  },
  {
   "t": "p",
   "inline": [
    {
     "s": "最后的一道记忆。"
    }
   ]
  },
  {
   "t": "p",
   "inline": [
    {
     "s": "在这最后一生的日子里，"
    }
   ]
  },
  {
   "t": "p",
   "inline": [
    {
     "s": "要紧的只有一件事，"
    }
   ]
  },
  {
   "t": "p",
   "inline": [
    {
     "s": "那就是："
    }
   ]
  },
  {
   "t": "p",
   "inline": [
    {
     "s": "出生入死，"
    },
    {
     "s": "（"
    },
    {
     "s": "出离生死，）"
    }
   ]
  },
  {
   "t": "p",
   "inline": [
    {
     "s": "超凡脱俗，"
    }
   ]
  },
  {
   "t": "p",
   "inline": [
    {
     "s": "证悟菩提。"
    }
   ]
  },
  {
   "t": "p",
   "inline": [
    {
     "s": "人生再长，"
    }
   ]
  },
  {
   "t": "p",
   "inline": [
    {
     "s": "不过百年，"
    }
   ]
  },
  {
   "t": "p",
   "inline": [
    {
     "s": "这一生的岁月，"
    }
   ]
  },
  {
   "t": "p",
   "inline": [
    {
     "s": "只是我在这个空间里的,"
    }
   ]
  },
  {
   "t": "p",
   "inline": [
    {
     "s": "一场梦幻而已。"
    }
   ]
  },
  {
   "t": "p",
   "inline": [
    {
     "s": "不论如何活着，"
    }
   ]
  },
  {
   "t": "p",
   "inline": [
    {
     "s": "快乐着，"
    }
   ]
  },
  {
   "t": "p",
   "inline": [
    {
     "s": "或者是痛苦着，"
    }
   ]
  },
  {
   "t": "p",
   "inline": [
    {
     "s": "其实都是，"
    }
   ]
  },
  {
   "t": "p",
   "inline": [
    {
     "s": "最有意义的一生，"
    }
   ]
  },
  {
   "t": "p",
   "inline": [
    {
     "s": "值得自豪的一生，"
    }
   ]
  },
  {
   "t": "p",
   "inline": [
    {
     "s": "值得珍惜的一生。"
    }
   ]
  },
  {
   "t": "p",
   "inline": [
    {
     "s": "这真是，"
    }
   ]
  },
  {
   "t": "p",
   "inline": [
    {
     "s": "这真是一件天大的喜事。"
    }
   ]
  },
  {
   "t": "p",
   "inline": [
    {
     "s": "当慧命在红尘历尽劫难之后，"
    }
   ]
  },
  {
   "t": "p",
   "inline": [
    {
     "s": "我终于可以回归那万有的源头。"
    }
   ]
  },
  {
   "t": "p",
   "inline": [
    {
     "s": "还有甚么值得抱怨、唠叨、"
    }
   ]
  },
  {
   "t": "p",
   "inline": [
    {
     "s": "遗憾、痛悔和嗔恨的呢？"
    }
   ]
  },
  {
   "t": "p",
   "inline": [
    {
     "s": "如果还有，"
    }
   ]
  },
  {
   "t": "p",
   "inline": [
    {
     "s": "那就是忘记了“最后”这两个字，"
    }
   ]
  },
  {
   "t": "p",
   "inline": [
    {
     "s": "或者是对“最后”这两个字，"
    }
   ]
  },
  {
   "t": "p",
   "inline": [
    {
     "s": "认识不够，"
    }
   ]
  },
  {
   "t": "p",
   "inline": [
    {
     "s": "信心不足。"
    }
   ]
  },
  {
   "t": "p",
   "inline": [
    {
     "s": "时时牢记着："
    }
   ]
  },
  {
   "t": "p",
   "inline": [
    {
     "s": "是我在红尘的最后一生！"
    }
   ]
  },
  {
   "t": "p",
   "inline": [
    {
     "s": "再来时，"
    }
   ]
  },
  {
   "t": "p",
   "inline": [
    {
     "s": "我必脚踏莲花，"
    }
   ]
  },
  {
   "t": "p",
   "inline": [
    {
     "s": "乘愿而来。"
    },
    {
     "s": "（"
    },
    {
     "s": "为救度众生，乘愿而来。）"
    }
   ]
  },
  {
