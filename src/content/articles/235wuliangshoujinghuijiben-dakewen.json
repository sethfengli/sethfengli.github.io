   ]
  },
  {
   "t": "p",
   "inline": [
    {
     "s": "一、《大阿弥陀经》，宋"
    },
    {
     "s": "·"
    },
    {
     "s": "王日休（王龙舒）会集，简称“无量寿经王会本”"
    },
    {
     "s": "；"
    }
   ]
  },
  {
   "t": "p",
   "inline": [
    {
     "s": "二、《无量寿经（彭绍升节校本）》，清初"
    },
    {
     "s": "·"
    },
    {
     "s": "彭绍升（彭际清、彭二林）根据魏译本节校，简称“无量寿经彭会本”"
